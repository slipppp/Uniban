<?xml version="1.0" encoding="UTF-8"?>

<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/uniban/wallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
      <!-- monitorVirtual1 = nome que o xfwm4 costuma usar em VM/monitor
           virtual (VirtualBox, QEMU virtio-vga, etc). Deixado igual pra
           não cair no wallpaper padrão do Xfce quando testar em VM.

           IMPORTANTE: isso aqui é só um FALLBACK estático pra 2 nomes
           comuns de monitor. Em hardware real o xrandr costuma dar nome
           tipo "eDP-1", "HDMI-A-1", "DP-1" etc - nome que MUDA por placa
           de vídeo/driver e não dá pra adivinhar em build time. Quando o
           nome do monitor não bate com "monitor0"/"monitorVirtual1", o
           Xfce ignora essa propriedade e mostra o fundo cinza padrão -
           por isso o wallpaper sumia depois de logar (era exatamente
           esse bug). O fix de verdade é o script
           /usr/share/uniban/apply-wallpaper.sh, que roda no login e
           detecta o nome real do monitor via xrandr. Esse XML aqui fica
           só de rede de segurança/primeiro-boot antes do script rodar. -->
      <property name="monitorVirtual1" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/uniban/wallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
