# === UniBan v0.1 - pacotes essenciais ===
# Filosofia: 90% Debian puro. Só tira bloat, não reinventa nada.

# Desktop leve (Xfce, não GNOME/KDE - menos RAM idle)
xfce4
xfce4-terminal
xfce4-taskmanager
xfce4-screenshooter
lightdm
lightdm-gtk-greeter

# Rede
network-manager
network-manager-gnome

# Áudio
pulseaudio
pulseaudio-utils
pavucontrol

# Bluetooth
bluetooth
bluez
blueman

# Navegador (Firefox ESR - já é pacote Debian oficial, sem hook externo, sem depender site fora)
firefox-esr
firefox-esr-l10n-pt-br

# Impressoras
cups

# Firmware (Wi-Fi, GPU, chipset - essencial p/ hardware real funcionar)
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
firmware-realtek
firmware-iwlwifi
firmware-atheros
intel-microcode
amd64-microcode

# Gráficos / jogos
mesa-utils
mesa-vulkan-drivers
xserver-xorg
xserver-xorg-video-all
xserver-xorg-input-all

# Utilitários mínimos essenciais (sem inchaço tipo LibreOffice, GIMP etc)
sudo
htop
gvfs
gvfs-backends
usbutils
pciutils
file-roller
gnome-disk-utility
