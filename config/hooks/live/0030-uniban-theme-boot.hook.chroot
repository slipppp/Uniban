#!/bin/sh
# UniBan - tema Arc-Dark (GTK2/GTK3/xfwm4) + splash de boot (Plymouth)
# Roda por último (0030): initramfs é regerado com tudo já instalado.
#
# Splash: Plymouth + tema "uniban" (includes.chroot/usr/share/plymouth/themes/uniban).
# Sem FRAMEBUFFER=y o Plymouth só aparece tarde (ou nunca) em muita máquina/VM.
# No fim confere DENTRO do initramfs - se o tema não entrou, o build FALHA
# (antes passava mudo e a ISO ficava sem logo).
#
# Arc-Dark: pacote arc-theme (Debian trixie: GTK2 + GTK3 + xfwm4). Padrão vem de
# includes.chroot (xsettings.xml, xfwm4.xml, gtk-2.0/3.0, greeter) E também
# gravado aqui nos arquivos do usuário (skel + /home/user) - assim nenhum
# first-run do Xfce volta pro tema claro. Faltou pasta do tema -> build FALHA.
set -e

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends plymouth
# deps do arc-theme (engine GTK2) entram normais; ícones/GTK2 dependem delas
apt-get install -y arc-theme gtk2-engines-murrine gtk2-engines-pixbuf gnome-themes-extra

# ------------------------------------------------------------------ Arc-Dark
for d in gtk-2.0 gtk-3.0 xfwm4; do
  [ -d "/usr/share/themes/Arc-Dark/$d" ] || { echo "ERRO: /usr/share/themes/Arc-Dark/$d não existe"; exit 1; }
done

GTK3_INI='[Settings]
gtk-theme-name=Arc-Dark
gtk-application-prefer-dark-theme=1'
GTK2_RC='gtk-theme-name="Arc-Dark"'
XSET='<?xml version="1.0" encoding="UTF-8"?>

<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Arc-Dark"/>
  </property>
</channel>'
XFWM='<?xml version="1.0" encoding="UTF-8"?>

<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Arc-Dark"/>
    <property name="use_compositing" type="bool" value="true"/>
  </property>
</channel>'

write_theme() {  # $1 = home (skel ou /home/user)
  mkdir -p "$1/.config/gtk-3.0" "$1/.config/xfce4/xfconf/xfce-perchannel-xml"
  printf '%s\n' "$GTK3_INI" > "$1/.config/gtk-3.0/settings.ini"
  printf '%s\n' "$GTK2_RC"  > "$1/.gtkrc-2.0"
  printf '%s\n' "$XSET"     > "$1/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml"
  printf '%s\n' "$XFWM"     > "$1/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml"
}
write_theme /etc/skel
if [ -d /home/user ]; then
  write_theme /home/user
  chown -R user:user /home/user/.config /home/user/.gtkrc-2.0
fi

# tema escuro também em /etc (GTK3 + GTK2), por cima do que veio do includes.chroot
mkdir -p /etc/gtk-3.0
printf '%s\n' "$GTK3_INI" > /etc/gtk-3.0/settings.ini
printf '%s\n' "$GTK2_RC"  > /etc/gtk-2.0/gtkrc

# -------------------------------------------------------------------- Plymouth
mkdir -p /etc/plymouth /etc/initramfs-tools/conf.d
cat > /etc/plymouth/plymouthd.conf << 'PCONF'
[Daemon]
Theme=uniban
ShowDelay=0
DeviceTimeout=8
PCONF
# framebuffer cedo no initramfs = splash aparece logo no começo do boot
echo "FRAMEBUFFER=y" > /etc/initramfs-tools/conf.d/uniban-splash

# ativa o tema do boot e regera initramfs (-R). Se falhar, tenta o caminho manual.
if ! plymouth-set-default-theme -R uniban; then
  plymouth-set-default-theme uniban
  update-initramfs -u -k all
fi
plymouth-set-default-theme | grep -qx uniban || { echo "ERRO: tema plymouth uniban não ativou"; exit 1; }

# confere de verdade: tema + plymouth dentro de TODO initramfs gerado
for i in /boot/initrd.img-*; do
  [ -f "$i" ] || continue
  lsinitramfs "$i" | grep -q 'plymouth/themes/uniban/uniban.script' \
    || { echo "ERRO: tema uniban NÃO entrou em $i"; exit 1; }
done

apt-get clean
