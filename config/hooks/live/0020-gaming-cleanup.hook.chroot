#!/bin/sh
# UniBan gaming prep + limpeza
# Regra: só remove o que é comprovadamente inútil pra maioria. Nada de "achismo".
set -e

# --- Multiarch (i386) -> necessário pra Steam/Proton/Wine no futuro ---
dpkg --add-architecture i386
apt-get update

# --- Gamemode: otimiza CPU governor/prioridade durante jogo (Feral Interactive, mantido oficial) ---
apt-get install -y gamemode

# --- locale/man/doc já cortados no hook 0001 (dpkg path-exclude,
#     roda antes de instalar tudo - localepurge que tinha aqui não
#     fazia nada de verdade, ele só limpa retroativo via trigger e
#     nessa altura o Xfce/Firefox já tinham instalado tudo) ---

# --- Remove pacotes que vêm por dependência mas ninguém usa numa distro gamer ---
apt-get purge -y \
    gnome-orca \
    speech-dispatcher \
    xfce4-screensaver \
    xterm \
    2>/dev/null || true

apt-get autoremove -y
apt-get clean
