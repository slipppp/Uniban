#!/bin/sh
# UniBan - layout de teclado BR (ABNT2) por padrão
# Faltava isso: sem configurar, o sistema cai em US - física ABNT2 com
# mapa US = várias tecla fora do lugar (`|`, `~`, `ç`, etc).
set -e

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y console-setup keyboard-configuration

cat > /etc/default/keyboard << 'EOF'
XKBMODEL="pc105"
XKBLAYOUT="br"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF
