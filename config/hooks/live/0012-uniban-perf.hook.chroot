#!/bin/sh
# UniBan - otimização de RAM pra máquina fraca (alvo: 2GB)
set -e

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y zram-tools earlyoom

# --- zram: swap comprimido em RAM. Em 2GB isso é o que mais evita
#     travada feia (SO indo pro disco) e "OOM kill errado" no meio do jogo ---
cat > /etc/default/zramswap << 'EOF'
ALGO=zstd
PERCENT=100
PRIORITY=100
EOF
systemctl enable zramswap.service

# --- earlyoom: mata processo problemático ANTES do kernel travar a
#     máquina inteira tentando decidir o que matar (SEM isso, em RAM
#     baixa o sistema pode congelar por vários segundos antes do OOM
#     killer normal agir) ---
systemctl enable earlyoom

# --- /tmp: trixie monta em tmpfs (RAM) por padrão. Bom pra velocidade,
#     perigoso em 2GB se Steam/Proton/download jogar arquivo grande lá
#     dentro - trava tudo. Limita tamanho, sobra vai pro disco normal ---
mkdir -p /etc/systemd/system/tmp.mount.d
cat > /etc/systemd/system/tmp.mount.d/uniban-size.conf << 'EOF'
[Mount]
Options=mode=1777,strictatime,size=512M
EOF
